     /// Queues the end notification for the sounds that have already finished.
     pub(super) fn poll_media(&mut self) -> Result<(), CpuError> {
         let now = self.now_us();
+        // **Not at every API boundary.** This method runs on every turn and every callback, and
+        // going through all live `IMedia`s each time was 8% of the core's time in Action Hero 3D
+        // (dozens of sounds, the RG52 Mini's A53, perf 2026-11-08). The list is looked at when the
+        // game's clock has moved half a millisecond since the last look: the end of a sound comes
+        // at most that much later. A clock that went back (a save state) looks at once.
+        if now >= self.media_checked_us && now < self.media_checked_us.saturating_add(500) {
+            return Ok(());
+        }
+        self.media_checked_us = now;
         // A track the mixer was looping for the game, and the game did not play again.
         let dropped: Vec<u32> = self
             .media
