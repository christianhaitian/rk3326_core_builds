+/// The CPU's frame inside the GPU: an RGB565 texture the size of the screen, attached to a read
+/// framebuffer, from which a blit takes it to the frontend's framebuffer.
+struct ScreenBridge {
+    /// The GPU the objects were made on ([`zeebx::video::gpu::gpu_address`]). On a new GPU they
+    /// are not valid and are not deleted: `libretro.h` says only to make them again.
+    gpu: usize,
+    texture: glow::Texture,
+    fbo: glow::Framebuffer,
+    size: (i32, i32),
+}
+
+/// The framebuffer the frontend wants this frame in.
+fn frontend_framebuffer() -> Option<u32> {
+    let get = GPU_OFFER
+        .lock()
+        .ok()
+        .and_then(|offer| offer.as_ref().and_then(|o| o.get_current_framebuffer))?;
+    Some(unsafe { get() })
+}
+
+/// Puts the CPU's frame into the frontend's framebuffer, so that it goes out as a GPU frame.
+///
+/// **With hardware rendering, RetroArch's `gl` driver does not read the CPU's pixels.** `gl2_frame`
+/// only copies the delivered frame when there is *no* hardware framebuffer
+/// (`GL2_FLAG_HW_RENDER_FBO_INIT`); with one, it presents the FBO and ignores the pointer, and
+/// `libretro.h` too only foresees, with hardware rendering, the sentinel or the null frame. A frame
+/// the GPU did not draw (2D through `IDisplay`/`IBitmap`, as Action Hero 3D's opening) came out
+/// black, with the sound right, in RetroArch on GLES (RG52 Mini, Mali-G52). Here the frame goes up
+/// into an RGB565 texture and a blit puts it into the frontend's framebuffer; the caller delivers
+/// the sentinel.
+///
+/// The origin is the top, as in the GPU's drawing (`bottom_left_origin` false): the frame's line 0
+/// goes to the framebuffer's line 0. Returns whether the frame was put there; with no frontend
+/// framebuffer or too few pixels nothing changes, and the caller delivers the pixels as before.
+fn present_through_bridge(
+    gl: &glow::Context,
+    bridge: &mut Option<ScreenBridge>,
+    width: u32,
+    height: u32,
+    rgb565: &[u8],
+) -> bool {
+    let (w, h) = (width as i32, height as i32);
+    if w <= 0 || h <= 0 || rgb565.len() < width as usize * height as usize * 2 {
+        return false;
+    }
+    let Some(fbo) = frontend_framebuffer() else {
+        return false;
+    };
+    let target = std::num::NonZeroU32::new(fbo).map(glow::NativeFramebuffer);
+    let address = zeebx::video::gpu::gpu_address(gl);
+    unsafe {
+        if bridge.as_ref().is_some_and(|b| b.gpu != address) {
+            *bridge = None;
+        }
+        if let Some(old) = bridge.take_if(|b| b.size != (w, h)) {
+            gl.delete_framebuffer(old.fbo);
+            gl.delete_texture(old.texture);
+        }
+        // The pixel unpack state is whoever came before: the frontend or the engine.
+        gl.bind_buffer(glow::PIXEL_UNPACK_BUFFER, None);
+        gl.pixel_store_i32(glow::UNPACK_ALIGNMENT, 2);
+        gl.pixel_store_i32(glow::UNPACK_ROW_LENGTH, 0);
+        gl.pixel_store_i32(glow::UNPACK_SKIP_ROWS, 0);
+        gl.pixel_store_i32(glow::UNPACK_SKIP_PIXELS, 0);
+        gl.active_texture(glow::TEXTURE0);
+        let pixels = glow::PixelUnpackData::Slice(Some(&rgb565[..width as usize * height as usize * 2]));
+        match bridge.as_ref() {
+            Some(b) => {
+                gl.bind_texture(glow::TEXTURE_2D, Some(b.texture));
+                gl.tex_sub_image_2d(
+                    glow::TEXTURE_2D,
+                    0,
+                    0,
+                    0,
+                    w,
+                    h,
+                    glow::RGB,
+                    glow::UNSIGNED_SHORT_5_6_5,
+                    pixels,
+                );
+            }
+            None => {
+                let Ok(texture) = gl.create_texture() else {
+                    return false;
+                };
+                gl.bind_texture(glow::TEXTURE_2D, Some(texture));
+                gl.tex_image_2d(
+                    glow::TEXTURE_2D,
+                    0,
+                    glow::RGB565 as i32,
+                    w,
+                    h,
+                    0,
+                    glow::RGB,
+                    glow::UNSIGNED_SHORT_5_6_5,
+                    pixels,
+                );
+                for (name, value) in [
+                    (glow::TEXTURE_MIN_FILTER, glow::NEAREST as i32),
+                    (glow::TEXTURE_MAG_FILTER, glow::NEAREST as i32),
+                    (glow::TEXTURE_WRAP_S, glow::CLAMP_TO_EDGE as i32),
+                    (glow::TEXTURE_WRAP_T, glow::CLAMP_TO_EDGE as i32),
+                    (glow::TEXTURE_MAX_LEVEL, 0),
+                ] {
+                    gl.tex_parameter_i32(glow::TEXTURE_2D, name, value);
+                }
+                let Ok(read) = gl.create_framebuffer() else {
+                    gl.bind_texture(glow::TEXTURE_2D, None);
+                    gl.delete_texture(texture);
+                    return false;
+                };
+                gl.bind_framebuffer(glow::READ_FRAMEBUFFER, Some(read));
+                gl.framebuffer_texture_2d(
+                    glow::READ_FRAMEBUFFER,
+                    glow::COLOR_ATTACHMENT0,
+                    glow::TEXTURE_2D,
+                    Some(texture),
+                    0,
+                );
+                *bridge = Some(ScreenBridge {
+                    gpu: address,
+                    texture,
+                    fbo: read,
+                    size: (w, h),
+                });
+            }
+        }
+        gl.bind_texture(glow::TEXTURE_2D, None);
+        gl.pixel_store_i32(glow::UNPACK_ALIGNMENT, 4);
+        let Some(b) = bridge.as_ref() else {
+            return false;
+        };
+        // The blit goes through the scissor and nothing else of the fragment stage; the engine
+        // turns the scissor on in 3D.
+        gl.disable(glow::SCISSOR_TEST);
+        gl.bind_framebuffer(glow::READ_FRAMEBUFFER, Some(b.fbo));
+        gl.bind_framebuffer(glow::DRAW_FRAMEBUFFER, target);
+        gl.blit_framebuffer(0, 0, w, h, 0, 0, w, h, glow::COLOR_BUFFER_BIT, glow::NEAREST);
+        gl.bind_framebuffer(glow::FRAMEBUFFER, target);
+    }
+    true
+}
+
